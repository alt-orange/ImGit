# imgit_embed_assets(<target> <directory>)
#
# Compiles every file under <directory> into <target>: one generated source per file holds its bytes (rebuilt when
# the file changes), and an index lists them by path for imgit::assets (src/app/assets.hpp). Adding or removing a
# file re-runs the glob on the next build (CONFIGURE_DEPENDS).

set(IMGIT_EMBED_FILE_SCRIPT ${CMAKE_CURRENT_LIST_DIR}/embed_file.cmake)

function(imgit_embed_assets target directory)
    file(GLOB_RECURSE files CONFIGURE_DEPENDS RELATIVE ${directory} ${directory}/*)
    list(SORT files)
    set(out_dir ${CMAKE_CURRENT_BINARY_DIR}/embedded_assets)
    set(declarations "")
    set(entries "")
    foreach(file IN LISTS files)
        string(MAKE_C_IDENTIFIER "imgit_asset_${file}" symbol)
        set(source ${out_dir}/${symbol}.cpp)
        add_custom_command(
            OUTPUT ${source}
            COMMAND ${CMAKE_COMMAND} -DIN=${directory}/${file} -DOUT=${source} -DSYMBOL=${symbol}
                    -P ${IMGIT_EMBED_FILE_SCRIPT}
            DEPENDS ${directory}/${file} ${IMGIT_EMBED_FILE_SCRIPT}
            COMMENT "Embedding assets/${file}"
            VERBATIM)
        target_sources(${target} PRIVATE ${source})
        string(APPEND declarations "extern const unsigned char ${symbol}[];\nextern const std::size_t ${symbol}_size;\n")
        string(APPEND entries "            {\"${file}\", ${symbol}, &${symbol}_size},\n")
    endforeach()
    list(LENGTH files count)

    set(index ${out_dir}/embedded_assets.cpp)
    set(content "// Generated by cmake/EmbedAssets.cmake: the files under assets/.\n")
    string(APPEND content "#include \"app/assets.hpp\"\n\n${declarations}\n")
    string(APPEND content "namespace imgit::assets::detail\n{\n")
    string(APPEND content "    const Entry ENTRIES[] = {\n${entries}    };\n")
    string(APPEND content "    const std::size_t ENTRY_COUNT = ${count};\n")
    string(APPEND content "} // namespace imgit::assets::detail\n")
    # Rewritten only when the list changes, so a new configure does not rebuild it.
    file(CONFIGURE OUTPUT ${index} CONTENT "${content}" @ONLY)
    target_sources(${target} PRIVATE ${index})
endfunction()
