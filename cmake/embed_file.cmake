# cmake -DIN=<file> -DOUT=<source.cpp> -DSYMBOL=<name> -P embed_file.cmake
#
# Writes OUT, a C++ source defining `const unsigned char SYMBOL[]` (the bytes of IN followed by a zero, so text
# assets read as C strings) and `const std::size_t SYMBOL_size` (without the zero).

file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" digits)
math(EXPR size "${digits} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "((0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,))"
       "\\1\n" bytes "${bytes}")
file(WRITE "${OUT}"
     "// Generated by cmake/embed_file.cmake from ${IN}\n"
     "#include <cstddef>\n\n"
     "extern const unsigned char ${SYMBOL}[];\n"
     "extern const std::size_t ${SYMBOL}_size;\n\n"
     "const unsigned char ${SYMBOL}[] = {\n${bytes}0x00};\n"
     "const std::size_t ${SYMBOL}_size = ${size};\n")
