# LeakSanitizer suppressions for the linux-asan preset (tools/memcheck/run_app.sh passes them): leaks in system
# libraries the app runs on, not ImGit's to fix. An entry matches a leak whose allocation stack passes through the
# library it names, so memory ImGit allocates itself is never hidden; memory such a library hands ImGit to free would
# be, so keep entries to libraries whose results ImGit does not own. LSAN_OPTIONS=print_suppressions=1 lists which
# entries fired.

# Mesa's GL driver and its LLVM JIT (llvmpipe on the headless CI runner), and the libglvnd dispatch in front of it
leak:libgallium
leak:libLLVM
leak:libGLX_mesa.so
leak:libGLdispatch.so
leak:/dri/

# Xlib / XCB, fontconfig and D-Bus (through GLFW and the native file dialog)
leak:libX11.so
leak:libxcb
leak:libfontconfig.so
leak:libdbus-1.so

# libraries dlopen()ed for the GL driver stay loaded until exit
leak:_dl_open
